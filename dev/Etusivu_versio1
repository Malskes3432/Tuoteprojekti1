:root {
    --color-bg-grey: #e6e6e6;
    --color-bg-dark: #b3b3b3;
    --color-text: #000000;
    --color-white: #ffff;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    color: var(--color-text);
    line-height: 1.5;
}

section {
    background-color:var(--color-white) ; 
}

section:nth-child(odd) {
    background-color:var(--color-bg-grey);

}

.container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
}


.text-center { text-align: center; }


.bg-grey { background-color: var(--color-bg-grey); }
.bg-white { background-color: #ffffff; }


h1, h2, h3 { margin-bottom: 15px; }
p, ul { margin-bottom: 15px; }
ul { margin-left: 20px; }


.site-header {
    padding: 20px 0;
    border-bottom: 1px solid #ccc;
}

.header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    border: 2px solid #000;
    padding: 10px 30px;
    border-radius: 50px;
    font-weight: bold;
}

.mobile-menu-btn {
    font-size: 24px;
    background: none;
    border: none;
    cursor: pointer;
}


.main-nav {
    display: none; 
    width: 100%;
}

.main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

.main-nav a {
    text-decoration: none;
    color: #000;
    font-size: 14px;
    font-weight: bold;
}


.introduction {
    padding: 60px 0;
}

.events-section, .cta-section, .content-section {
    padding: 40px 0;
}

.events-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
}

.event-card {
    background-color: var(--color-bg-grey);
    text-align: center;
}

.card-image {
    background-color: #ccc;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
}

.card-content {
    padding: 20px;
}

.btn {
    background-color: #333;
    color: #fff;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    margin-top: 10px;
}

.content-image-placeholder {
    background-color: #ccc;
    height: 300px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
}


.site-footer {
    background-color: var(--color-bg-dark);
    padding: 40px 0;
    margin-top: 40px;
}

.footer-flex {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
}

.bg-white-logo {
    background-color: #fff;
}


@media (min-width: 768px) {
    

    .mobile-menu-btn {
        display: none;
    }


    .main-nav {
        display: block;
        width: auto;
    }

    .main-nav ul {
        display: flex;
        gap: 30px;
    }

   
    .events-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .footer-flex {
        flex-direction: row;
        justify-content: space-between;
        text-align: left;
    } 
}
